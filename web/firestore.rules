rules_version = '2';

// Security rules for the firebase-seed example.
//   users  -> any signed-in user can read a profile; only the owner writes their own.
//   cars   -> any signed-in user can read; only the car's owner can write/delete it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUser(d) {
      return d.displayName is string && d.displayName.size() <= 100
             && d.email is string;
    }

    // Mirrors the Car type in src/data/cars.ts. Keep these in sync when you
    // change the model. The seed runs via the Admin SDK and bypasses these rules.
    function validCar(d) {
      return d.make is string && d.make.size() >= 1 && d.make.size() <= 100
             && d.model is string && d.model.size() >= 1 && d.model.size() <= 100
             && d.year is number
             && d.price is number
             && d.mileageKm is number
             && d.isElectric is bool
             && d.fuelType in ['petrol', 'diesel', 'electric', 'hybrid']
             && d.features is list
             && d.specs is map
             && d.location is latlng
             && (d.soldAt == null || d.soldAt is timestamp)
             && d.ownerId is string
             && d.createdAt is timestamp
             && d.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && validUser(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /cars/{carId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && validCar(request.resource.data);

      // owner-only writes; ownership cannot be transferred via update
      allow update: if isOwner(resource.data.ownerId)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && validCar(request.resource.data);

      allow delete: if isOwner(resource.data.ownerId);
    }

    // A saved Risk game is an event-sourced blob. The nested engine state is too
    // large/dynamic to validate field-by-field in rules, so we validate only the
    // denormalised top-level fields and trust the client reducer + tests for the
    // rest. Games are owner-private: only the owner can read or write.
    function validGame(d) {
      return d.ownerId is string
             && d.name is string && d.name.size() >= 1 && d.name.size() <= 120
             && d.status in ['setup', 'active', 'finished']
             && d.winCondition in ['world_domination', 'secret_mission']
             && d.playerCount is number && d.playerCount >= 2 && d.playerCount <= 6
             && d.schemaVersion is number
             && d.rev is number
             && d.turnNumber is number
             && d.initialState is map
             && d.cachedState is map
             && d.events is list && d.events.size() < 5000
             && d.redoStack is list
             && d.createdAt is timestamp
             && d.updatedAt is timestamp;
    }

    match /games/{gameId} {
      allow read: if isOwner(resource.data.ownerId);

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && validGame(request.resource.data);

      allow update: if isOwner(resource.data.ownerId)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && validGame(request.resource.data);

      allow delete: if isOwner(resource.data.ownerId);
    }
  }
}
